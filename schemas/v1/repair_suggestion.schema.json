{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "description": "Typed pointer to evidence; a digest pins content when it is known.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "artifact",
            "run",
            "event",
            "finding",
            "capsule",
            "task",
            "memory",
            "approval",
            "context_bundle",
            "envelope"
          ],
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "sha256"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "$id": "urn:ghostlab:contract:repair_suggestion:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``suggest-idempotency-repair`` output: a reviewable proposal, never executable code.",
  "properties": {
    "adapter_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_-]{1,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "change_kind": {
      "enum": [
        "use_checked_in_adapter",
        "describe_change_for_review"
      ],
      "type": "string"
    },
    "cited": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array"
    },
    "description": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
    },
    "rationale": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
    },
    "risks": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "target_invariants": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{1,63}$",
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "type": "array"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "world_version": {
      "enum": [
        "refund-world/1",
        "group-journey/1",
        "service-relay/1"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "world_version",
    "title",
    "target_invariants",
    "change_kind",
    "adapter_id",
    "description",
    "rationale",
    "risks",
    "cited"
  ],
  "title": "RepairSuggestion",
  "type": "object"
}
