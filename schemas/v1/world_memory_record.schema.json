{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "description": "Where content came from. Only controller/verifier/human sources are trusted.",
      "properties": {
        "observed_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "controller",
            "verifier",
            "human",
            "memory",
            "tool_result",
            "model_output"
          ],
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "trust": {
          "enum": [
            "trusted",
            "verified",
            "untrusted"
          ],
          "type": "string"
        }
      },
      "required": [
        "source_kind",
        "source_ref",
        "observed_at",
        "trust"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "Typed pointer to evidence; a digest pins content when it is known.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "artifact",
            "run",
            "event",
            "finding",
            "capsule",
            "task",
            "memory",
            "approval",
            "context_bundle",
            "envelope"
          ],
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "sha256"
      ],
      "title": "Ref",
      "type": "object"
    },
    "RetentionPolicy": {
      "additionalProperties": false,
      "properties": {
        "audit_hold": {
          "type": "boolean"
        },
        "expires_at": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy": {
          "enum": [
            "campaign",
            "project",
            "audit"
          ],
          "type": "string"
        }
      },
      "required": [
        "policy",
        "expires_at",
        "audit_hold"
      ],
      "title": "RetentionPolicy",
      "type": "object"
    }
  },
  "$id": "urn:ghostlab:contract:world_memory_record:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "campaign_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "content": {
      "maxLength": 8000,
      "minLength": 1,
      "type": "string"
    },
    "effective_from": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "type": "string"
    },
    "effective_until": {
      "anyOf": [
        {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "maxItems": 64,
      "type": "array"
    },
    "kind": {
      "enum": [
        "episodic_event",
        "finding",
        "preference",
        "procedure_ref"
      ],
      "type": "string"
    },
    "observed_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "record_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "retention": {
      "$ref": "#/$defs/RetentionPolicy"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "status": {
      "enum": [
        "unverified",
        "verified",
        "contradicted",
        "superseded",
        "expired"
      ],
      "type": "string"
    },
    "supersedes": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "maxItems": 32,
      "type": "array"
    },
    "world_version": {
      "enum": [
        "refund-world/1",
        "group-journey/1",
        "service-relay/1"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "project_id",
    "campaign_id",
    "world_version",
    "kind",
    "content",
    "evidence",
    "provenance",
    "status",
    "observed_at",
    "effective_from",
    "effective_until",
    "supersedes",
    "retention"
  ],
  "title": "WorldMemoryRecord",
  "type": "object"
}
