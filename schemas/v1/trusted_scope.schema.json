{
  "$defs": {
    "Principal": {
      "additionalProperties": false,
      "description": "Identity derived from an authenticated session, never from a request body.",
      "properties": {
        "kind": {
          "enum": [
            "human",
            "service",
            "local_dev"
          ],
          "type": "string"
        },
        "principal_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "principal_id",
        "kind"
      ],
      "title": "Principal",
      "type": "object"
    }
  },
  "$id": "urn:ghostlab:contract:trusted_scope:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Authority the controller grants for one task. Model output never sets this.",
  "properties": {
    "allowed_tools": {
      "items": {
        "enum": [
          "get_order",
          "issue_refund",
          "get_refund_status"
        ],
        "type": "string"
      },
      "maxItems": 16,
      "type": "array"
    },
    "delegated_by": {
      "anyOf": [
        {
          "enum": [
            "supervisor",
            "worldsmith",
            "explorer",
            "analyst",
            "target",
            "verifier"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "issued_by": {
      "const": "controller",
      "type": "string"
    },
    "policy_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "principal": {
      "$ref": "#/$defs/Principal"
    },
    "project_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "role": {
      "enum": [
        "supervisor",
        "worldsmith",
        "explorer",
        "analyst",
        "target",
        "verifier"
      ],
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "principal",
    "role",
    "delegated_by",
    "allowed_tools",
    "policy_version",
    "issued_by"
  ],
  "title": "TrustedScope",
  "type": "object"
}
