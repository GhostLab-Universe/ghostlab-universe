{
  "$defs": {
    "ErrorInfo": {
      "additionalProperties": false,
      "description": "Typed error. side_effect records whether a world action may have committed.",
      "properties": {
        "code": {
          "enum": [
            "validation_failed",
            "unauthenticated",
            "forbidden",
            "not_found",
            "conflict",
            "budget_exhausted",
            "cancelled",
            "deadline_exceeded",
            "rate_limited",
            "provider_transient",
            "provider_permanent",
            "provider_invalid_output",
            "tool_error",
            "tool_timeout",
            "approval_required",
            "approval_invalid",
            "internal"
          ],
          "type": "string"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "side_effect": {
          "enum": [
            "none",
            "committed",
            "unknown"
          ],
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "side_effect",
        "ref"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "LedgerRow": {
      "additionalProperties": false,
      "properties": {
        "amount_minor": {
          "maximum": 1000000000000000,
          "minimum": 1,
          "type": "integer"
        },
        "customer_id": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "order_id": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "transaction_id": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "transaction_id",
        "order_id",
        "customer_id",
        "amount_minor",
        "idempotency_key"
      ],
      "title": "LedgerRow",
      "type": "object"
    },
    "OrderRecord": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "customer_id": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "order_id": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "paid_minor": {
          "maximum": 1000000000000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "order_id",
        "customer_id",
        "paid_minor",
        "currency"
      ],
      "title": "OrderRecord",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "Typed pointer to evidence; a digest pins content when it is known.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "artifact",
            "run",
            "event",
            "finding",
            "capsule",
            "task",
            "memory",
            "approval",
            "context_bundle",
            "envelope"
          ],
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "sha256"
      ],
      "title": "Ref",
      "type": "object"
    },
    "RefundStatus": {
      "additionalProperties": false,
      "properties": {
        "refund": {
          "anyOf": [
            {
              "$ref": "#/$defs/LedgerRow"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "committed",
            "not_found"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "refund"
      ],
      "title": "RefundStatus",
      "type": "object"
    }
  },
  "$id": "urn:ghostlab:contract:tool_result:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_id": {
      "anyOf": [
        {
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "invocation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "output": {
      "anyOf": [
        {
          "$ref": "#/$defs/OrderRecord"
        },
        {
          "$ref": "#/$defs/RefundStatus"
        },
        {
          "$ref": "#/$defs/LedgerRow"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_call_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "invocation_id",
    "provider_call_id",
    "event_id",
    "status",
    "output",
    "error"
  ],
  "title": "ToolResult",
  "type": "object"
}
