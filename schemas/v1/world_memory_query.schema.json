{
  "$id": "urn:ghostlab:contract:world_memory_query:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "type": "string"
    },
    "campaign_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "kinds": {
      "items": {
        "enum": [
          "episodic_event",
          "finding",
          "preference",
          "procedure_ref"
        ],
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 1,
      "type": "array"
    },
    "limit": {
      "maximum": 200,
      "minimum": 1,
      "type": "integer"
    },
    "project_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "statuses": {
      "items": {
        "enum": [
          "unverified",
          "verified",
          "contradicted",
          "superseded",
          "expired"
        ],
        "type": "string"
      },
      "maxItems": 5,
      "minItems": 1,
      "type": "array"
    },
    "world_version": {
      "anyOf": [
        {
          "enum": [
            "refund-world/1",
            "group-journey/1",
            "service-relay/1"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "campaign_id",
    "world_version",
    "kinds",
    "statuses",
    "as_of",
    "limit"
  ],
  "title": "WorldMemoryQuery",
  "type": "object"
}
