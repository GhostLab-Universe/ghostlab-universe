{
  "$id": "urn:ghostlab:contract:approval_submission:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Client request body. The approver is taken from the session, never from here.",
  "properties": {
    "action_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "approval_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "decision": {
      "enum": [
        "approve",
        "reject"
      ],
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "approval_id",
    "action_digest",
    "decision",
    "reason"
  ],
  "title": "ApprovalSubmission",
  "type": "object"
}
