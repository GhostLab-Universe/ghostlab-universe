{
  "$id": "urn:ghostlab:contract:budget_limits:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cost_currency": {
      "anyOf": [
        {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "max_cost_minor": {
      "anyOf": [
        {
          "maximum": 1000000000000000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "max_input_tokens": {
      "maximum": 1000000000000,
      "minimum": 0,
      "type": "integer"
    },
    "max_model_calls": {
      "maximum": 1000000000000,
      "minimum": 0,
      "type": "integer"
    },
    "max_output_tokens": {
      "maximum": 1000000000000,
      "minimum": 0,
      "type": "integer"
    },
    "max_parallel_runs": {
      "maximum": 64,
      "minimum": 1,
      "type": "integer"
    },
    "max_tool_calls": {
      "maximum": 1000000000000,
      "minimum": 0,
      "type": "integer"
    },
    "max_wall_clock_ms": {
      "maximum": 1000000000000,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "max_model_calls",
    "max_tool_calls",
    "max_input_tokens",
    "max_output_tokens",
    "max_cost_minor",
    "cost_currency",
    "max_wall_clock_ms",
    "max_parallel_runs"
  ],
  "title": "BudgetLimits",
  "type": "object"
}
