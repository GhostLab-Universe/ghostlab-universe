{
  "$defs": {
    "Principal": {
      "additionalProperties": false,
      "description": "Identity derived from an authenticated session, never from a request body.",
      "properties": {
        "kind": {
          "enum": [
            "human",
            "service",
            "local_dev"
          ],
          "type": "string"
        },
        "principal_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "principal_id",
        "kind"
      ],
      "title": "Principal",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "Typed pointer to evidence; a digest pins content when it is known.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "artifact",
            "run",
            "event",
            "finding",
            "capsule",
            "task",
            "memory",
            "approval",
            "context_bundle",
            "envelope"
          ],
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "sha256"
      ],
      "title": "Ref",
      "type": "object"
    },
    "TrustedScope": {
      "additionalProperties": false,
      "description": "Authority the controller grants for one task. Model output never sets this.",
      "properties": {
        "allowed_tools": {
          "items": {
            "enum": [
              "get_order",
              "issue_refund",
              "get_refund_status"
            ],
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "delegated_by": {
          "anyOf": [
            {
              "enum": [
                "supervisor",
                "worldsmith",
                "explorer",
                "analyst",
                "target",
                "verifier"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "issued_by": {
          "const": "controller",
          "type": "string"
        },
        "policy_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "principal": {
          "$ref": "#/$defs/Principal"
        },
        "project_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "role": {
          "enum": [
            "supervisor",
            "worldsmith",
            "explorer",
            "analyst",
            "target",
            "verifier"
          ],
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "principal",
        "role",
        "delegated_by",
        "allowed_tools",
        "policy_version",
        "issued_by"
      ],
      "title": "TrustedScope",
      "type": "object"
    }
  },
  "$id": "urn:ghostlab:contract:approval_request:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "action_kind": {
      "enum": [
        "apply_repair",
        "change_policy",
        "execute_consequential_action"
      ],
      "type": "string"
    },
    "approval_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "campaign_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "created_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "type": "string"
    },
    "expires_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "type": "string"
    },
    "material_risks": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array"
    },
    "payload": {
      "$ref": "#/$defs/Ref"
    },
    "policy_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "requested_by_role": {
      "enum": [
        "supervisor",
        "worldsmith",
        "explorer",
        "analyst",
        "target",
        "verifier"
      ],
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/TrustedScope"
    },
    "status": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired",
        "consumed"
      ],
      "type": "string"
    },
    "summary": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
    },
    "task_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "approval_id",
    "campaign_id",
    "task_id",
    "action_kind",
    "action_digest",
    "payload",
    "summary",
    "material_risks",
    "requested_by_role",
    "scope",
    "policy_version",
    "status",
    "created_at",
    "expires_at"
  ],
  "title": "ApprovalRequest",
  "type": "object"
}
