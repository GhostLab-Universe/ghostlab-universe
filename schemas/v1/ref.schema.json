{
  "$id": "urn:ghostlab:contract:ref:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Typed pointer to evidence; a digest pins content when it is known.",
  "properties": {
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "artifact",
        "run",
        "event",
        "finding",
        "capsule",
        "task",
        "memory",
        "approval",
        "context_bundle",
        "envelope"
      ],
      "type": "string"
    },
    "sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "kind",
    "id",
    "sha256"
  ],
  "title": "Ref",
  "type": "object"
}
