{
  "$id": "urn:ghostlab:contract:world_invariant_finding:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A verifier verdict from world evidence, never model confidence.",
  "properties": {
    "evidence_event_ids": {
      "items": {
        "maximum": 1000,
        "minimum": 1,
        "type": "integer"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "finding_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "invariant": {
      "pattern": "^[a-z][a-z0-9_]{1,63}$",
      "type": "string"
    },
    "limit_value": {
      "anyOf": [
        {
          "maximum": 1000000000000000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_value": {
      "anyOf": [
        {
          "maximum": 1000000000000000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "recorded_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "unit": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "verdict": {
      "enum": [
        "passed",
        "failed"
      ],
      "type": "string"
    },
    "verifier_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "world_version": {
      "enum": [
        "refund-world/1",
        "group-journey/1",
        "service-relay/1"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "finding_id",
    "run_id",
    "world_version",
    "invariant",
    "verifier_version",
    "verdict",
    "evidence_event_ids",
    "observed_value",
    "limit_value",
    "unit",
    "recorded_at"
  ],
  "title": "WorldInvariantFinding",
  "type": "object"
}
