# Copy to .env locally. Never commit values. Keys stay server-side and out of
# logs, prompts, capsules and browser bundles.
#
# No live endpoint or model is enabled by default. Live calls require an
# authorized key, the exact enabled model and a bounded budget (M01 probe gate).

# Phase 1 live models (ghostlab.llm). Keys are mapped by label: dev = local runs,
# public = public deploy only. GLIMMER_BASE_URL may be http only on loopback or the
# WSL default gateway (local Ollama), e.g. http://172.21.32.1:11434/v1
META_API_KEY_DEV=
META_API_KEY_PUBLIC=
META_BASE_URL=
GLIMMER_BASE_URL=

# Direct Meta Responses (primary). Documented base URL: https://api.meta.ai/v1
# Exact enabled model access is unverified; record it via the M01 probe.
GHOSTLAB_PROVIDER=
MODEL_API_KEY=
GHOSTLAB_META_BASE_URL=
GHOSTLAB_META_MODEL_ID=

# Baseten Chat Completions (conditional fallback, separate adapter).
# Selecting it is an explicit new experiment, never a silent switch.
BASETEN_API_KEY=
GHOSTLAB_BASETEN_BASE_URL=
GHOSTLAB_BASETEN_MODEL_ID=

# Local SQLite store for the single-coordinator MVP. Never commit the file.
GHOSTLAB_SQLITE_PATH=artifacts/local/ghostlab.sqlite

# LangGraph pulls in langsmith transitively. Its presence does not authorize
# trace export; keep it off unless redaction and a destination are approved.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
