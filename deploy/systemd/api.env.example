# EXAMPLE ONLY. Copy to /etc/ghostlab/env/api.env (owner ghostlab, mode 0600)
# and fill in on the host. NEVER commit the filled file, never print it, never
# paste it into tickets. All values below are empty on purpose.
#
# Auth: hosted cutover waits for PR #22 (OPEN). Do not set local_dev here: it
# is refused in any hosted deployment by local_dev.py, and this unit never
# binds off-loopback anyway.
GHOSTLAB_AUTH_MODE=
GHOSTLAB_DEPLOYMENT=hosted

# Storage root. Must be the directory whose files are laid out by
# StoragePaths: ghostlab.sqlite, graph-checkpoints.sqlite, artifacts/.
GHOSTLAB_SQLITE_PATH=/var/lib/ghostlab/ghostlab.sqlite

# Live inference gate (the existing --live path; all four or none).
# The model MUST stay muse-spark-1.3: live.py qualifies exactly that id and
# refuses invented ids. The key travels by env only, never on a command line.
GHOSTLAB_LIVE=0
GHOSTLAB_LIVE_MODEL=
GHOSTLAB_LIVE_MAX_CALLS=
# Compat report path must be under /srv/ghostlab/app or /var/lib/ghostlab
# (ProtectSystem=strict/ProtectHome hides /home and /root from the unit).
GHOSTLAB_LIVE_COMPAT_REPORT=
GHOSTLAB_CONFIRM_PAID_CALLS=0
GHOSTLAB_ALLOW_SERVER_RETENTION=0
MODEL_API_KEY=
GHOSTLAB_META_BASE_URL=

# Explicitly off unless redaction and a destination are approved.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
